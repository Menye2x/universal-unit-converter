# ---------------------------------------------------------------
# Interval / Ranges Calculator
# Static single-file web app: no build step, no dependencies.
# ---------------------------------------------------------------

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.history/

# Dependencies (if tooling is added later)
node_modules/
bower_components/
jspm_packages/

# Package manager logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.pnpm-store/
.eslintcache
.stylelintcache
.parcel-cache/
.cache/

# Build and output folders (if a build step is added later)
dist/
build/
out/
.next/
.vite/
coverage/

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs and runtime data
logs/
*.log
*.pid
*.seed

# Temporary and backup files
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# Test artifacts
playwright-report/
test-results/
screenshots/

# Archives and exports
*.zip
*.tar.gz
*.7z
